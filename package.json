{
  "name": "@local/mermaid-pele",
  "version": "0.1.0",
  "private": true,
  "description": "Render Mermaid diagrams as themeable SVG cards in the Harness chat, using Pele.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "client.pele.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dependencies": {
    "pele": "^1.13.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
